{
  "applications": {
    "gecko": {
      "id": "tabtweak@mozillaonline.com",
      "strict_min_version": "61.0a1",
      "update_url": "https://archive.mozilla.org/pub/cn_pack/addons.json"
    }
  },
  "default_locale": "en_US",
  "description": "__MSG_extensionDescription__",
  "experiment_apis": {
    "tabTweak": {
      "schema": "mozillaonline/schemas/tab_tweak.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "mozillaonline/parent/ext-tabTweak.js",
        "events": ["startup"]
      }
    }
  },
  "homepage_url": "http://www.firefox.com.cn/",
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png"
  },
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "options_ui": {
    "browser_style": true,
    "page": "options.html"
  },
  "permissions": [
    "browserSettings",
    "mozillaAddons"
  ],
  "version": "6.1"
}
